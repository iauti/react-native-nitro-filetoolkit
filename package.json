{
  "name": "react-native-nitro-filetoolkit-root",
  "version": "0.0.1",
  "private": true,
  "packageManager": "bun@1.3.3",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "bun run --cwd packages/react-native-nitro-filetoolkit typescript",
    "check:ci": "bun run check:generated && bun run test && bun run test:community && bun run typecheck && bun run lint && bun run build && bun run --cwd apps/example verify:structure && bun run --cwd apps/example typecheck && bun run package:check",
    "check:generated": "bun run specs && git diff --exit-code -- packages/react-native-nitro-filetoolkit/nitrogen",
    "lint": "bun run --cwd packages/react-native-nitro-filetoolkit lint-ci && bun run --cwd apps/example lint",
    "package:check": "bun run build && node scripts/validate-package.mjs",
    "release": "./scripts/release.sh",
    "release-it": "release-it",
    "specs": "bun run --cwd packages/react-native-nitro-filetoolkit specs",
    "test": "bun run --cwd packages/react-native-nitro-filetoolkit test",
    "test:community": "node --test tests/community-files.test.mjs",
    "typecheck": "bun run --cwd packages/react-native-nitro-filetoolkit typecheck"
  },
  "devDependencies": {
    "@release-it/bumper": "^8.0.0",
    "@release-it/conventional-changelog": "^12.0.0",
    "release-it": "^21.0.0",
    "yaml": "^2.9.0"
  },
  "patchedDependencies": {
    "nitrogen@0.37.1": "patches/nitrogen@0.37.1.patch"
  }
}
