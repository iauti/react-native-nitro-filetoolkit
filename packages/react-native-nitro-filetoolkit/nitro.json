{
  "$schema": "https://nitro.margelo.com/nitro.schema.json",
  "cxxNamespace": [
    "filetoolkit"
  ],
  "ios": {
    "iosModuleName": "NitroFileToolkit"
  },
  "android": {
    "androidNamespace": [
      "filetoolkit"
    ],
    "androidCxxLibName": "NitroFileToolkit"
  },
  "autolinking": {
    "FileToolkitFactory": {
      "ios": {
        "language": "swift",
        "implementationClassName": "HybridFileToolkitFactory"
      },
      "android": {
        "language": "kotlin",
        "implementationClassName": "HybridFileToolkitFactory"
      }
    }
  },
  "ignorePaths": [
    "**/node_modules"
  ]
}
